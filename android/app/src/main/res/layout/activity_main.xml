<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 中部全屏地图区域：高德导航地图 -->
    <com.amap.api.navi.AMapNaviView
        android:id="@+id/naviView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 中部全屏地图区域：Google Maps 全球高清互动地图 -->
    <WebView
        android:id="@+id/googleMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 全屏沉浸模式下的微型唤起药丸提示 -->
    <TextView
        android:id="@+id/mapFullscreenHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_speech_bubble"
        android:elevation="8dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="🗺️ 全屏地图模式 (轻点地图恢复菜单)"
        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        android:textColor="#334155"
        android:visibility="gone" />

    <!-- 全屏沉浸模式下的悬浮说话大按钮 -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/floatingMicButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#6366F1"
        android:elevation="14dp"
        android:text="🎙️ 按键说话"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        app:cornerRadius="28dp" />

    <!-- 顶部极简浮动栏：搜索 + 快捷地点 + 虚拟行车 + 记忆 + 设置 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_top_bar"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_input"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/searchButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="12dp"
                android:text="@string/search_action"
                android:textSize="13sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="⚙️"
                android:textSize="16sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- 顶部单行滑动快捷入口 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quickHomeButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/quick_home"
                    android:textSize="12sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quickCompanyButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/quick_company"
                    android:textSize="12sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quickGasButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/quick_gas"
                    android:textSize="12sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quickChargeButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/quick_charge"
                    android:textSize="12sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/simChinaNaviButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="10dp"
                    android:text="🗺️ 虚拟行车"
                    android:textSize="12sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/locateButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/locate_btn"
                    android:textSize="11sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/aroundButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/around_btn"
                    android:textSize="11sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/memoryButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/memory_btn"
                    android:textSize="12sp"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 搜索结果浮层 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/searchResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="96dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardElevation="10dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="240dp">

            <LinearLayout
                android:id="@+id/searchResultList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <!-- 底部驾驶大卡片（精简大视野，支持展开） -->
    <LinearLayout
        android:id="@+id/bottomDriverCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_driver_card"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- 状态与路况信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/nav_standby_distance_time"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="#0F172A"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/roadNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/nav_standby_road"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="#64748B" />
            </LinearLayout>

            <TextView
                android:id="@+id/voiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="#E2E8F0"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="#475569" />
        </LinearLayout>

        <!-- 副驾老朋友说话气泡 + 动态数字人形象 -->
        <LinearLayout
            android:id="@+id/copilotBubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_speech_bubble"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <!-- 动态高颜值虚拟副驾人偶 -->
            <com.qmxz.pilotbot.avatar.view.AvatarView
                android:id="@+id/copilotAvatarView"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/copilotBubbleTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 副驾老朋友说："
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="#2563EB"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/copilotText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingMultiplier="1.15"
                    android:maxLines="3"
                    android:text="@string/copilot_default"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="#0F172A"
                    android:textIsSelectable="true"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 主操作栏：按键说话 + 启停导航 + 展开打字/详情按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/micButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.3"
                android:text="@string/mic_button"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startNavigationButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/start_test_navigation"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopNavigationButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#EF4444"
                android:text="@string/stop_navigation"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/expandButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="6dp"
                android:text="💬 更多"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 可折叠区域：文字输入 + 快捷Chips + 对话记录 -->
        <LinearLayout
            android:id="@+id/panelBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 常用搭话快捷 Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/quickChipHello"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingHorizontal="8dp"
                        android:text="💬 你好！"
                        android:textSize="11sp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/quickChipWho"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:paddingHorizontal="8dp"
                        android:text="💬 你是谁？"
                        android:textSize="11sp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/quickChipJoke"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:paddingHorizontal="8dp"
                        android:text="😄 讲个笑话"
                        android:textSize="11sp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/quickChipEta"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:paddingHorizontal="8dp"
                        android:text="⏱️ 还有多久到"
                        android:textSize="11sp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/quickChipRemember"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:paddingHorizontal="8dp"
                        android:text="🧠 记住我爱喝美式"
                        android:textSize="11sp"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 文字输入行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/chatInput"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@android:drawable/edit_text"
                    android:hint="@string/chat_input_hint"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sendButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/send_button"
                    android:textSize="13sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/transcriptScroll"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="6dp"
                android:background="@android:drawable/edit_text">

                <TextView
                    android:id="@+id/transcriptText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textIsSelectable="true" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
